<Window x:Class="Sentinel.Engine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sentinel"
        WindowStyle="None"
        Background="#1a1a1e"
        Topmost="False"
        Width="480"
        Height="640"
        MinWidth="360"
        MinHeight="480"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2a2a2e"/>
                    <Setter Property="Foreground" Value="#ddd"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#c42b1c"/>
                    <Setter Property="Foreground" Value="#fff"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#1a1a1e">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" x:Name="TitleBarRow"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="#1a1a1e" x:Name="TitleBarGrid"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Sentinel"
                           Foreground="#666"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"
                           FontSize="12"
                           FontWeight="Medium"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Content="−" Click="MinimizeBtn_Click"
                            Style="{StaticResource WindowButton}"/>
                        <Button x:Name="MaximizeBtn" Content="{Binding MaximizeIcon, RelativeSource={RelativeSource AncestorType=Window}}" Click="MaximizeBtn_Click"
                            Style="{StaticResource WindowButton}"/>
                    <Button Content="×" Click="CloseBtn_Click"
                            Style="{StaticResource CloseButton}"/>
                </StackPanel>
            </Grid>

            <!-- WebView Content -->
            <wv2:WebView2 x:Name="WebView" Grid.Row="1"
                          DefaultBackgroundColor="#1a1a1e"/>
        </Grid>
    </Border>
</Window>
